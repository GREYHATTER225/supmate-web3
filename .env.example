# DeSo Node RPC URL (default: https://node.deso.org)
REACT_APP_NODE_URL=https://node.deso.org

# Supmate WebSocket Gateway URL for real-time messaging push
REACT_APP_GATEWAY_WS_URL=ws://localhost:5000/ws

# Supmate Gateway HTTP URL for push notifications and health checks
REACT_APP_GATEWAY_HTTP_URL=http://localhost:5000
